# ---- Vercel の環境変数に設定する（Settings → Environment Variables）----
# サーバー専用（フロントに出ない）
GEMINI_API_KEY=            # Google AI Studio で発行（有料枠のプロジェクト）
SUPABASE_SERVICE_ROLE_KEY= # Supabase Dashboard → Settings → API Keys
CRON_SECRET=               # ランダムな長い文字列（Vercel Cron の認証に使う）

# モデル名（変わりやすいので環境変数。既定値は 2026-11 時点の確認値）
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash

# サーバー・フロント共通
SUPABASE_URL=https://imhsajhnappghezkrmre.supabase.co

# フロント用（ビルド時に埋め込まれる。公開可の値のみ）
VITE_SUPABASE_URL=https://imhsajhnappghezkrmre.supabase.co
VITE_SUPABASE_ANON_KEY=    # Supabase の Publishable (anon) キー
