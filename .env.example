# .env.example — このファイルをコピーして .env を作る
#   cp .env.example .env
# .env は .gitignore 済み。秘密情報をコードに直書きしないこと。

# --- NCBI 規約(必須) -------------------------------------------------------
# E-utilities は全リクエストに tool= と email= を要求する。
NCBI_TOOL=arthroplasty-watch
NCBI_EMAIL=

# --- NCBI APIキー(任意) ----------------------------------------------------
# 設定すると 10 req/秒、未設定なら 3 req/秒でリクエストする。
# 取得先: https://account.ncbi.nlm.nih.gov/ → Account settings → API Key Management
NCBI_API_KEY=

# --- 出力先(Obsidian vault) ------------------------------------------------
# iCloud Driveの「デスクトップとドキュメント」同期が有効なMacでは ~/Desktop が
# iCloud上のデスクトップを指すため、通常はこのままでよい。
VAULT_DIR=~/Desktop/Claude/文献監視エージェント
# 同期が無効・パスが違う場合は、実体パスを指定する:
# VAULT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Desktop/Claude/文献監視エージェント

# --- 取得設定 --------------------------------------------------------------
# esearch の reldate(日)。週次実行に対し重複バッファを持たせて取りこぼしを防ぐ。
RELDATE=10

# 状態ファイル(取得済みPMID・症例報告保管庫)の置き場所。
# 既定はリポジトリ内の state/。iCloud上には置かない(同期競合を避けるため)。
# STATE_DIR=

# HTTP設定
HTTP_TIMEOUT=30
MAX_RETRIES=4
