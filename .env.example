# .env.example — このファイルをコピーして .env を作る
#   cp .env.example .env
# .env は .gitignore 済み。秘密情報をコードに直書きしないこと。

# --- NCBI 規約(必須) -------------------------------------------------------
# E-utilities は全リクエストに tool= と email= を要求する。
NCBI_TOOL=arthroplasty-watch
NCBI_EMAIL=

# --- NCBI APIキー(任意) ----------------------------------------------------
# 設定すると 10 req/秒、未設定なら 3 req/秒でリクエストする。
# 取得先: https://account.ncbi.nlm.nih.gov/ → Account settings → API Key Management
NCBI_API_KEY=

# --- 出力先(Obsidian vault) ------------------------------------------------
# 必ず「Obsidianが実際に読みに行くvault」を指定する。
# そうでないとノートがObsidianに取り込まれず、検索もリンクも効かない。
VAULT_DIR=~/Desktop/KOHEI-Vault
# iCloudの「デスクトップとドキュメント」同期が無効・パスが違う場合は実体パスを指定する:
# VAULT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Desktop/KOHEI-Vault

# vault内のどのフォルダに出すか。既定は <vault>/文献監視/人工関節/
# 症例報告はさらにその下の 症例報告/ に入る。
# SUBDIR=文献監視/人工関節

# --- 取得設定 --------------------------------------------------------------
# esearch の reldate(日)。週次実行に対し重複バッファを持たせて取りこぼしを防ぐ。
RELDATE=10

# 状態ファイル(取得済みPMID・症例報告保管庫)の置き場所。
# 既定はリポジトリ内の state/。iCloud上には置かない(同期競合を避けるため)。
# STATE_DIR=

# HTTP設定
HTTP_TIMEOUT=30
MAX_RETRIES=4
